# Copy to `.env` in this directory, then `docker compose up -d`.
#
# These variables are only read on the FIRST boot, when the container writes
# /data/config.yaml. After that the file is the source of truth — edit it with
# `docker compose exec tai tai edit`, or by hand in the volume. Changing a
# variable here later will not move a setting that config.yaml already holds.
#
# The exceptions are secrets: config.yaml references them as ${VAR}, so they
# are read on every boot and can be rotated by changing them here.

# ── Model (required) ────────────────────────────────────────────────────────
# The model name your provider serves. No default — a guessed one produces a
# container that starts and then 404s on the first message.
TAI_MODEL=llama3.2

# OpenAI-wire endpoint. Ollama on the host is the example; vLLM, llama.cpp,
# LM Studio and any OpenAI-compatible gateway work the same way.
#   Ollama:  http://host.docker.internal:11434/v1
#   vLLM:    http://host.docker.internal:8000/v1
#   Remote:  https://your-gateway.example.com/v1
TAI_BASE_URL=http://host.docker.internal:11434/v1

# Provider factory id. "openai_compatible" is built in and covers every
# OpenAI-wire server. Hosted vendors (anthropic, openai, openrouter, bedrock,
# deepseek) ship as plugin packages — install one with
# `docker compose exec tai tai plugin install @tailored-ai/provider-anthropic`
# and then set this to its id.
# TAI_PROVIDER=openai_compatible

# Provider API key, if the endpoint needs one. Written to /data/.env on first
# boot and referenced from config.yaml as ${OPENAI_COMPATIBLE_API_KEY}.
# TAI_API_KEY=

# ── Server ──────────────────────────────────────────────────────────────────
# Where the published port lands on the HOST. Leave at 127.0.0.1 unless
# something in front of TAI authenticates — see docs/self-hosting.md.
# TAI_PUBLISH_ADDR=127.0.0.1
# TAI_PUBLISH_PORT=3000

# API bearer token. Leave unset and first boot generates one, prints it to the
# log, and stores it in /data/.env. Set it here to choose your own or to
# rotate one (a value here outranks the stored one).
# TAI_AUTH_TOKEN=

# ── Channels ────────────────────────────────────────────────────────────────
# Discord is the built-in channel; first boot writes it disabled. Enable it in
# config.yaml, then supply the credentials here.
# DISCORD_BOT_TOKEN=
# DISCORD_OWNER_ID=

# ── Image ───────────────────────────────────────────────────────────────────
# Override to run a published image instead of building locally, e.g.
# TAI_IMAGE=ghcr.io/quintonmiller/tai:latest
# TAI_IMAGE=tai:local
