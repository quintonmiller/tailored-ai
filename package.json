{
  "name": "autonomous-agent",
  "private": true,
  "description": "Lightweight, modular AI agent framework. Bring your own model — any OpenAI-compatible endpoint, local or hosted.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "pack:check": "bash scripts/pack-check.sh",
    "guard:pre-v1": "node scripts/guard-pre-v1.mjs",
    "guard:runtime-deps": "node scripts/guard-runtime-deps.mjs",
    "dev": "pnpm --filter @tailored-ai/core run build && pnpm --filter @tailored-ai/server run build && pnpm --filter @tailored-ai/cli run dev",
    "dev:msg": "pnpm --filter @tailored-ai/core run build && pnpm --filter @tailored-ai/server run build && pnpm --filter @tailored-ai/cli run dev -- --message",
    "dev:ui": "pnpm --filter @tailored-ai/ui run dev",
    "dev:site": "pnpm --filter @tailored-ai/site run dev",
    "start": "pnpm --filter @tailored-ai/cli run start",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:watch": "pnpm --filter @tailored-ai/core run test -- --watch",
    "test:e2e": "pnpm --filter @tailored-ai/integration-tests run test:e2e",
    "eval": "pnpm --filter @tailored-ai/evals run eval",
    "eval:compare": "pnpm --filter @tailored-ai/evals run eval:compare",
    "lint": "biome check packages/",
    "lint:fix": "biome check --write packages/",
    "format": "biome format --write packages/",
    "build:ui": "pnpm --filter @tailored-ai/ui run build",
    "publish:cli": "pnpm --filter @tailored-ai/cli publish --access public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quintonmiller/tailored-ai.git"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "ollama",
    "openai",
    "tools",
    "local-llm",
    "discord-bot"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@changesets/cli": "^2.31.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}