{
  "name": "@tailored-ai/trusted-actions",
  "version": "0.1.7",
  "description": "Trusted-actions executor: approval gateway, push notifications, execution runner, Playwright adapters. HITL gateway for agent-driven purchases and other risky actions.",
  "license": "MIT",
  "author": "Quinton Miller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quintonmiller/tailored-ai.git",
    "directory": "packages/trusted-actions"
  },
  "homepage": "https://github.com/quintonmiller/tailored-ai/tree/main/packages/trusted-actions#readme",
  "bugs": "https://github.com/quintonmiller/tailored-ai/issues",
  "keywords": [
    "ai",
    "agent",
    "hitl",
    "approval",
    "playwright",
    "amazon",
    "trusted-actions",
    "web-push"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tai-executor": "dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/build-pwa.cjs",
    "typecheck": "tsc --noEmit",
    "dev": "node --watch dist/cli/bin.js serve",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@tailored-ai/core": "workspace:*",
    "better-sqlite3": "^11.7.0",
    "hono": "^4.11.8",
    "playwright": "^1.58.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
