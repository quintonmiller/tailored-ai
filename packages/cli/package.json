{
  "name": "@tailored-ai/cli",
  "version": "0.1.5",
  "description": "Tailored AI CLI — lightweight, modular AI agent framework optimized for local LLMs. `tai` command.",
  "license": "MIT",
  "author": "Quinton Miller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quintonmiller/tailored-ai.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/quintonmiller/tailored-ai#readme",
  "bugs": "https://github.com/quintonmiller/tailored-ai/issues",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "cli",
    "ollama",
    "openai",
    "anthropic",
    "tools",
    "local-llm",
    "vllm",
    "agentic"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tai": "dist/index.js"
  },
  "files": [
    "dist/",
    "ui-dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/bundle-ui.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo ui-dist",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@tailored-ai/core": "workspace:*",
    "@tailored-ai/server": "workspace:*",
    "diff": "^9.0.0",
    "dotenv": "^17.2.4",
    "ink": "^7.0.5",
    "react": "^19.2.4",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
