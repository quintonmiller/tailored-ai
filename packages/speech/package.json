{
  "name": "@tailored-ai/speech",
  "version": "0.1.10",
  "description": "Speech synthesis tools for Tailored AI agents. Turns text into audio through a pluggable provider — OpenAI, or any OpenAI-compatible server such as a local Kokoro. Ships as a register(ctx) plugin.",
  "license": "MIT",
  "author": "Quinton Miller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quintonmiller/tailored-ai.git",
    "directory": "packages/speech"
  },
  "homepage": "https://github.com/quintonmiller/tailored-ai/tree/main/packages/speech#readme",
  "bugs": "https://github.com/quintonmiller/tailored-ai/issues",
  "keywords": [
    "ai",
    "agent",
    "tailored-ai",
    "tts",
    "text-to-speech",
    "speech-synthesis",
    "podcast"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tailored-ai/core": "workspace:*"
  },
  "devDependencies": {
    "@tailored-ai/core": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
