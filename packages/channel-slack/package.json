{
  "name": "@tailored-ai/channel-slack",
  "version": "0.1.3",
  "description": "Slack channel for Tailored AI agents. Importing the package registers Slack as a channel factory; the runtime starts it when channels.slack.enabled is true.",
  "license": "MIT",
  "author": "Quinton Miller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quintonmiller/tailored-ai.git",
    "directory": "packages/channel-slack"
  },
  "homepage": "https://github.com/quintonmiller/tailored-ai/tree/main/packages/channel-slack#readme",
  "bugs": "https://github.com/quintonmiller/tailored-ai/issues",
  "keywords": [
    "ai",
    "agent",
    "tailored-ai",
    "slack",
    "channel",
    "bot"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@slack/bolt": "^3.21.0"
  },
  "peerDependencies": {
    "@tailored-ai/core": "workspace:*"
  },
  "devDependencies": {
    "@tailored-ai/core": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
